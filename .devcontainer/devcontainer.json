{
  "name": "Temaj ERP — mjedis provë",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "containerEnv": {
    "DATABASE_URL": "postgres://temaj:temaj-prove@localhost:5432/temaj_erp",
    "APP_ENV": "development"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Temaj ERP", "onAutoForward": "openBrowser" },
    "4000": { "label": "API (i brendshëm)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "postAttachCommand": "cat HYRJA.txt 2>/dev/null || true"
}
