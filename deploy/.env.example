# Kopjoje si .env në këtë dosje. Mos e ruani .env në Git.
# Emri i domenit që tregon te serveri (regjistrim A në DNS). HTTPS merret automatikisht.
SITE_ADDRESS=erp-prove.shembull.com
# Fjalëkalim i gjatë dhe i rastësishëm për databazën.
DB_PASSWORD=
# Çelësi për enkriptimin e sekreteve 2FA. Gjenerojeni: openssl rand -base64 32   → shkruajeni si k1:<vlera>
SECRET_KEYS=k1:
SECRET_ACTIVE_KEY_ID=k1
