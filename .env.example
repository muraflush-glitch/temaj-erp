# Kopjoje si .env. Mos e ruaj kurrë .env në Git.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/temaj_erp_dev
API_PORT=4000
# Vetëm Development/Staging. Production kërkon sekrete nga KMS.
SESSION_TTL_MINUTES=480
# Çelësat për enkriptimin e sekreteve (2FA). Gjeneroni: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Në Production vijnë nga KMS, jo nga ky skedar.
SECRET_KEYS=k1:VENDOS_CELESIN_BASE64_32_BAJT
SECRET_ACTIVE_KEY_ID=k1
# Kufizimi i hyrjes sipas IP-së
LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW_MINUTES=15
# Numri i proxy-ve para API-së (load balancer); bosh = asnjë
TRUST_PROXY=
# Punëtori i outbox-it dhe eskalimit
WORKER_ENABLED=true
WORKER_INTERVAL_MS=15000
